@model (int Page, int PageCount, int Total)
@{
    string Link(int p)
    {
        var query = Context.Request.Query
            .Where(kv => !string.Equals(kv.Key, "Page", StringComparison.OrdinalIgnoreCase))
            .SelectMany(kv => kv.Value.Select(v => Uri.EscapeDataString(kv.Key) + "=" + Uri.EscapeDataString(v ?? "")))
            .Append("Page=" + p);
        return Context.Request.Path + "?" + string.Join("&", query);
    }
}
<nav class="d-flex justify-content-between align-items-center" aria-label="分頁">
    <span class="small text-muted">共 @Model.Total 筆，第 @Model.Page / @Model.PageCount 頁</span>
    <ul class="pagination pagination-sm mb-0">
        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(Model.Page - 1)">上一頁</a></li>
        <li class="page-item @(Model.Page >= Model.PageCount ? "disabled" : "")"><a class="page-link" href="@Link(Model.Page + 1)">下一頁</a></li>
    </ul>
</nav>
