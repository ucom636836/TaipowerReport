@using Taipower.Safety.Core.Forms.Workflow
@using Taipower.Safety.Core.Forms.Pr1
@using Taipower.Safety.Web.Models
@model Pr1FormViewModel
@{
    ViewData["Title"] = "工安巡查紀錄表 " + Model.Form.DisplayNumber;
    var f = Model.Form;
    bool Has(WorkflowAction a) => Model.Allowed.Contains(a);
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">工安巡查紀錄表 <small class="text-muted">@f.DisplayNumber</small></h1>
    <span class="badge bg-info text-dark fs-6">@WorkflowDisplay.StepName(f.Step, f.Status)</span>
</div>

<dl class="row">
    <dt class="col-sm-2">巡查類別</dt><dd class="col-sm-4">@PatrolType.Names.GetValueOrDefault(f.PatrolType)</dd>
    <dt class="col-sm-2">巡查日期</dt><dd class="col-sm-4">@f.PatrolDate.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-2">工程</dt><dd class="col-sm-4">@Model.Project?.ProjectNumber @Model.Project?.Name</dd>
    <dt class="col-sm-2">承攬商</dt><dd class="col-sm-4">@Model.Contractor?.Name</dd>
    <dt class="col-sm-2">督促組別</dt><dd class="col-sm-4">@Model.Groups.FirstOrDefault(g => g.GroupId == (f.InformGroupId ?? f.ImproveGroupId))?.Name</dd>
    <dt class="col-sm-2">改善期限</dt><dd class="col-sm-4">@(f.ImproveDeadline?.ToString("yyyy-MM-dd") ?? "—")</dd>
</dl>

@foreach (var (title, items, isCon) in new[] { ("優點", Model.Pros, false), ("缺點", Model.Cons, true), ("建議改善事項", Model.Recommends, false) })
{
    <h2 class="h6 mt-3">@title</h2>
    <table class="table table-sm table-bordered">
        <thead><tr><th style="width:3rem">#</th><th>敘述</th>@if (isCon){<th>危害類型</th><th>改善/查證</th>}</tr></thead>
        <tbody>
        @foreach (var it in items)
        {
            <tr>
                <td>@it.Ordinal</td>
                <td>@it.Description</td>
                @if (isCon)
                {
                    <td>@it.HazardLabel</td>
                    <td>
                        @if (it.Improved == true) { <span class="text-success">改善完成</span> }
                        else if (it.Improved == false) { <span class="text-danger">未改善：@it.NotImprovedReason</span> }
                        @if (it.Verified == true) { <span class="badge bg-success">查證通過</span> }
                        else if (it.Verified == false) { <span class="badge bg-danger">查證未過</span> }

                        @if (it.PenaltyTicketNumber is { Length: > 0 })
                        {
                            <div class="mt-1"><span class="badge bg-dark">罰單 @it.PenaltyTicketNumber</span></div>
                        }
                        else if (User.HasFeature(Features.Pr5Create))
                        {
                            <div class="mt-1">
                                <a asp-controller="Pr5" asp-action="Create" asp-route-sourceFormId="@f.FormId" asp-route-sourceItemId="@it.ItemId"
                                   class="btn btn-outline-danger btn-sm">開罰單</a>
                            </div>
                        }

                        @{ var hasPhotos = it.BeforePhotos.Any() || it.AfterPhotos.Any(); }
                        @if (hasPhotos || Model.CanAct)
                        {
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                @foreach (var (photos, label, border) in new[] { (it.BeforePhotos, "改善前", "#dc3545"), (it.AfterPhotos, "改善後", "#198754") })
                                {
                                    foreach (var ph in photos)
                                    {
                                        <figure class="m-0 text-center" style="width:80px">
                                            <a href="@Url.Action("Photo", new { id = ph.AttachmentId })" target="_blank" title="@ph.OriginalName">
                                                <img src="@Url.Action("Photo", new { id = ph.AttachmentId })" alt="@label"
                                                     style="height:72px;width:72px;object-fit:cover;border:2px solid @border;border-radius:4px" />
                                            </a>
                                            <figcaption class="small" style="color:@border">@label</figcaption>
                                            @if (Model.CanAct)
                                            {
                                                <form asp-action="DeletePhoto" method="post" onsubmit="return confirm('刪除這張照片？')" class="d-inline">
                                                    <input type="hidden" name="formId" value="@f.FormId" />
                                                    <input type="hidden" name="attachmentId" value="@ph.AttachmentId" />
                                                    <button type="submit" class="btn btn-link btn-sm text-danger p-0" style="font-size:.75rem">刪除</button>
                                                </form>
                                            }
                                        </figure>
                                    }
                                }
                            </div>
                            @if (Model.CanAct)
                            {
                                <form asp-action="UploadPhoto" method="post" enctype="multipart/form-data" class="d-flex gap-1 align-items-center mt-1 flex-wrap">
                                    <input type="hidden" name="formId" value="@f.FormId" />
                                    <input type="hidden" name="itemId" value="@it.ItemId" />
                                    <select name="category" class="form-select form-select-sm" style="width:auto">
                                        <option value="Before">改善前</option>
                                        <option value="After">改善後</option>
                                    </select>
                                    <input type="file" name="file" accept="image/jpeg,image/png,image/gif,image/webp" class="form-control form-control-sm" style="width:auto" required />
                                    <button type="submit" class="btn btn-outline-secondary btn-sm">上傳</button>
                                </form>
                            }
                        }
                    </td>
                }
            </tr>
        }
        @if (!items.Any()) { <tr><td colspan="@(isCon ? 4 : 2)" class="text-muted">無</td></tr> }
        </tbody>
    </table>
}

@if (Model.CanAct && f.Step.Position == Position.Officer && (f.Step.Stage == Stage.Improvement || f.Step.Stage == Stage.Verification))
{
    var isImprove = f.Step.Stage == Stage.Improvement;
    var cons = Model.Cons.ToList();
    <div class="card my-4 border-primary">
        <div class="card-header">@(isImprove ? "逐項改善結果（C4 經辦組處理改善）" : "逐項查證結果（C5 工安組查證）")</div>
        <div class="card-body">
            @if (cons.Count == 0)
            {
                <p class="text-muted mb-0">本單無缺點項目，無需填寫。</p>
            }
            else
            {
                <form asp-action="SaveItemResults" method="post">
                    <input type="hidden" name="formId" value="@f.FormId" />
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th style="width:3rem">#</th><th>缺點敘述</th>
                                @if (isImprove) { <th style="width:8rem">改善情形</th><th style="width:10rem">改善日期</th><th>未改善原因</th> }
                                else { <th style="width:8rem">查證結果</th><th>查證說明</th> }
                            </tr>
                        </thead>
                        <tbody>
                        @for (var i = 0; i < cons.Count; i++)
                        {
                            var it = cons[i];
                            <tr>
                                <td>@it.Ordinal</td>
                                <td>@it.Description<input type="hidden" name="items[@i].ItemId" value="@it.ItemId" /></td>
                                @if (isImprove)
                                {
                                    <td>
                                        <select name="items[@i].Improved" class="form-select form-select-sm">
                                            <option value="">未填</option>
                                            <option value="true" selected="@(it.Improved == true)">改善完成</option>
                                            <option value="false" selected="@(it.Improved == false)">未改善</option>
                                        </select>
                                    </td>
                                    <td><input type="date" name="items[@i].ImprovedDate" value="@(it.ImprovedDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" /></td>
                                    <td><input name="items[@i].NotImprovedReason" value="@it.NotImprovedReason" maxlength="300" class="form-control form-control-sm" placeholder="若未改善，請說明" /></td>
                                }
                                else
                                {
                                    <td>
                                        <select name="items[@i].Verified" class="form-select form-select-sm">
                                            <option value="">未填</option>
                                            <option value="true" selected="@(it.Verified == true)">查證通過</option>
                                            <option value="false" selected="@(it.Verified == false)">查證未過</option>
                                        </select>
                                    </td>
                                    <td><input name="items[@i].VerifyReason" value="@it.VerifyReason" maxlength="300" class="form-control form-control-sm" placeholder="查證說明" /></td>
                                }
                            </tr>
                        }
                        </tbody>
                    </table>
                    <button type="submit" class="btn btn-primary btn-sm">儲存@(isImprove ? "改善" : "查證")結果</button>
                    <span class="text-muted small ms-2">可多次儲存；完成後再按下方「送出 / 上呈」繼續流程。</span>
                </form>
            }
        </div>
    </div>
}

@if (Model.CanAct)
{
    <div class="card my-4">
        <div class="card-header">簽核處理</div>
        <div class="card-body">
            <form asp-action="Act" method="post" class="row g-3">
                <input type="hidden" name="FormId" value="@f.FormId" />

                @if (Has(WorkflowAction.AssignChief) || Has(WorkflowAction.AssignOfficer))
                {
                    <div class="col-md-6">
                        <label class="form-label">指派對象（員工代號）</label>
                        <input name="AssigneeId" class="form-control" placeholder="例如 610826" />
                    </div>
                }
                @if (f.Step.Stage == Stage.SafetyReview && f.Step.Position == Position.Officer)
                {
                    <div class="col-md-4">
                        <label class="form-label">督促組別</label>
                        <select name="InformGroupId" class="form-select">
                            <option value="">請選擇</option>
                            @foreach (var g in Model.Groups) { <option value="@g.GroupId" selected="@(g.GroupId == f.InformGroupId)">@g.Name</option> }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">改善期限</label>
                        <input name="ImproveDeadline" type="date" class="form-control" />
                    </div>
                    <div class="col-12 form-check ms-2">
                        <input type="checkbox" name="IsJump" value="true" class="form-check-input" id="jump" />
                        <label class="form-check-label" for="jump">跳關直送經理（略過課長）</label>
                    </div>
                }
                @if (f.Step.Position == Position.Chief && f.Step.Stage != Stage.Approval)
                {
                    <div class="col-12 form-check ms-2">
                        <input type="checkbox" name="IsProxy" value="true" class="form-check-input" id="proxy" />
                        <label class="form-check-label" for="proxy">代理經理簽核（送他課課長）</label>
                    </div>
                }
                @if (Has(WorkflowAction.CloseDecision))
                {
                    <div class="col-12">
                        <div class="form-check form-check-inline"><input class="form-check-input" type="radio" name="AgreeClose" value="true" id="ac1" checked /><label class="form-check-label" for="ac1">同意結案</label></div>
                        <div class="form-check form-check-inline"><input class="form-check-input" type="radio" name="AgreeClose" value="false" id="ac0" /><label class="form-check-label" for="ac0">不同意結案（退回經辦組）</label></div>
                    </div>
                }

                <div class="col-12">
                    <label class="form-label">意見 / 批示</label>
                    <textarea name="Comment" class="form-control" rows="2" maxlength="1000"></textarea>
                </div>
                <div class="col-12">
                    @foreach (var a in Model.Allowed.Where(a => a != WorkflowAction.Withdraw && a != WorkflowAction.NotifyContractor))
                    {
                        var cls = a is WorkflowAction.Approve ? "btn-success"
                            : a.ToString().StartsWith("Return") || a is WorkflowAction.Reject ? "btn-outline-danger"
                            : "btn-primary";
                        <button type="submit" name="Action" value="@a" class="btn @cls me-2 mb-2">@WorkflowDisplay.ActionName(a)</button>
                    }
                </div>
            </form>
        </div>
    </div>
}
else if (f.Status == FormStatus.InProgress)
{
    <div class="alert alert-secondary">此單目前由 <strong>@(f.PendingRecipientId ?? "—")</strong> 處理中，您僅能檢視。</div>
}

<h2 class="h6 mt-4">簽核歷程</h2>
<table class="table table-sm table-striped small">
    <thead><tr><th>時間</th><th>處理人</th><th>動作</th><th>意見</th></tr></thead>
    <tbody>
    @foreach (var h in Model.History)
    {
        <tr><td class="text-nowrap">@h.OccurredAt.ToString("yyyy-MM-dd HH:mm")</td><td>@h.ActorTitle</td><td>@h.Action</td><td>@h.Comment</td></tr>
    }
    </tbody>
</table>
<a asp-action="Index" class="btn btn-outline-secondary btn-sm">回查詢</a>
