@model Taipower.Safety.Web.Controllers.ReferencePageModel
@{ ViewData["Title"] = "基本資料維護"; }
<h1 class="h4 mb-3">基本資料維護</h1>

<h2 class="h5 mt-4" id="projects">工程</h2>
<a asp-action="EditProject" class="btn btn-sm btn-primary mb-2">新增工程</a>
<table class="table table-sm table-striped align-middle">
    <thead><tr><th>工程編號</th><th>工程名稱</th><th>機組/期別</th><th>承攬商</th><th>狀態</th><th></th></tr></thead>
    <tbody>
    @foreach (var p in Model.Projects)
    {
        <tr class="@(p.IsActive ? "" : "text-muted")">
            <td>@p.ProjectNumber</td><td>@p.Name</td><td>@p.UnitPeriod</td>
            <td>@string.Join("、", Model.Contractors.Where(c => p.ContractorIds.Contains(c.ContractorId)).Select(c => c.Name))</td>
            <td>@(p.IsActive ? "啟用" : "停用")</td>
            <td><a asp-action="EditProject" asp-route-id="@p.ProjectId" class="btn btn-link btn-sm">編輯</a></td>
        </tr>
    }
    </tbody>
</table>

<h2 class="h5 mt-4" id="contractors">承攬商</h2>
<a asp-action="EditContractor" class="btn btn-sm btn-primary mb-2">新增承攬商</a>
<table class="table table-sm table-striped align-middle">
    <thead><tr><th>名稱</th><th>聯絡人 (通知信收件者)</th><th>狀態</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model.Contractors)
    {
        <tr class="@(c.IsActive ? "" : "text-muted")">
            <td>@c.Name</td>
            <td>@string.Join("、", c.Contacts.Select(x => $"{x.Name} <{x.Email}>"))</td>
            <td>@(c.IsActive ? "啟用" : "停用")</td>
            <td><a asp-action="EditContractor" asp-route-id="@c.ContractorId" class="btn btn-link btn-sm">編輯</a></td>
        </tr>
    }
    </tbody>
</table>

<h2 class="h5 mt-4" id="catalogue">危害類型 / 缺失類別 / 缺失項目</h2>
<p class="small text-muted">名稱欄位可直接修改後按「存」。最下方空白列為新增。</p>
<div class="row g-4">
    <div class="col-lg-3">
        <h3 class="h6">危害類型</h3>
        @foreach (var h in Model.Hazards.Append(new Taipower.Safety.Core.Reference.Hazard(0, "")))
        {
            <form asp-action="SaveHazard" method="post" class="input-group input-group-sm mb-1">
                <input type="hidden" name="hazardId" value="@h.HazardId" />
                <span class="input-group-text">@(h.HazardId == 0 ? "新" : h.HazardId)</span>
                <input name="name" value="@h.Name" class="form-control" maxlength="30" aria-label="危害類型名稱" />
                <button class="btn btn-outline-primary">存</button>
            </form>
        }
    </div>
    <div class="col-lg-4">
        <h3 class="h6">缺失類別</h3>
        @foreach (var t in Model.Types.Append(new Taipower.Safety.Core.Reference.DeficiencyType(0, 0, "")))
        {
            <form asp-action="SaveDeficiencyType" method="post" class="input-group input-group-sm mb-1">
                <input type="hidden" name="deficiencyTypeId" value="@t.DeficiencyTypeId" />
                <select name="hazardId" class="form-select" style="max-width: 9rem" aria-label="危害類型">
                    @foreach (var h in Model.Hazards) { <option value="@h.HazardId" selected="@(h.HazardId == t.HazardId)">@h.Name</option> }
                </select>
                <input name="name" value="@t.Name" class="form-control" maxlength="50" aria-label="缺失類別名稱" />
                <button class="btn btn-outline-primary">存</button>
            </form>
        }
    </div>
    <div class="col-lg-5">
        <h3 class="h6">缺失項目</h3>
        @foreach (var i in Model.Items.Append(new Taipower.Safety.Core.Reference.DeficiencyItem(0, 0, "")))
        {
            <form asp-action="SaveDeficiencyItem" method="post" class="input-group input-group-sm mb-1">
                <input type="hidden" name="deficiencyItemId" value="@i.DeficiencyItemId" />
                <select name="deficiencyTypeId" class="form-select" style="max-width: 9rem" aria-label="缺失類別">
                    @foreach (var t in Model.Types) { <option value="@t.DeficiencyTypeId" selected="@(t.DeficiencyTypeId == i.DeficiencyTypeId)">@t.Name</option> }
                </select>
                <input name="name" value="@i.Name" class="form-control" maxlength="200" aria-label="缺失項目名稱" />
                <button class="btn btn-outline-primary">存</button>
            </form>
        }
    </div>
</div>
