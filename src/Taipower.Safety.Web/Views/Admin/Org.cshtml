@model Taipower.Safety.Web.Controllers.OrgPageModel
@{ ViewData["Title"] = "組織維護"; }
<h1 class="h4 mb-3">組織維護</h1>
<div class="row g-4">
    <div class="col-lg-6">
        <h2 class="h6">組別</h2>
        <table class="table table-sm table-striped align-middle">
            <thead><tr><th>代碼</th><th>名稱</th><th>上層</th><th>排序</th></tr></thead>
            <tbody>
            @foreach (var g in Model.Groups)
            {
                <tr><td>@g.GroupId</td><td>@g.Name</td><td>@Model.Groups.FirstOrDefault(x => x.GroupId == g.ParentGroupId)?.Name</td><td>@g.SortOrder</td></tr>
            }
            </tbody>
        </table>
        <form asp-action="SaveGroup" method="post" class="row g-2 border rounded p-2">
            <div class="col-3"><input name="groupId" class="form-control form-control-sm" placeholder="代碼" maxlength="3" required /></div>
            <div class="col-4"><input name="name" class="form-control form-control-sm" placeholder="名稱" maxlength="30" required /></div>
            <div class="col-3">
                <select name="parentGroupId" class="form-select form-select-sm">
                    <option value="">(無上層)</option>
                    @foreach (var g in Model.Groups) { <option value="@g.GroupId">@g.Name</option> }
                </select>
            </div>
            <div class="col-2"><input name="sortOrder" type="number" class="form-control form-control-sm" value="0" /></div>
            <div class="col-12"><button class="btn btn-sm btn-primary">新增 / 更新組別</button> <span class="small text-muted">代碼相同即為更新</span></div>
        </form>
    </div>
    <div class="col-lg-6">
        <h2 class="h6">課別</h2>
        <table class="table table-sm table-striped align-middle">
            <thead><tr><th>組別</th><th>課別代碼</th><th>名稱</th></tr></thead>
            <tbody>
            @foreach (var s in Model.Sections)
            {
                <tr><td>@Model.Groups.FirstOrDefault(x => x.GroupId == s.GroupId)?.Name</td><td>@s.SectionCode</td><td>@s.Name</td></tr>
            }
            </tbody>
        </table>
        <form asp-action="SaveSection" method="post" class="row g-2 border rounded p-2">
            <div class="col-4">
                <select name="groupId" class="form-select form-select-sm" required>
                    @foreach (var g in Model.Groups) { <option value="@g.GroupId">@g.Name</option> }
                </select>
            </div>
            <div class="col-3"><input name="sectionCode" class="form-control form-control-sm" placeholder="課別代碼" maxlength="3" required /></div>
            <div class="col-5"><input name="name" class="form-control form-control-sm" placeholder="名稱" maxlength="30" required /></div>
            <div class="col-12"><button class="btn btn-sm btn-primary">新增 / 更新課別</button></div>
        </form>
    </div>
</div>
